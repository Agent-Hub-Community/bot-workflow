# 环境变量模板。复制成 .env.local（被 .gitignore 忽略）并填值，然后在当前 shell 加载：
#
#   cp config/env.example .env.local
#   set -a; . ./.env.local; set +a
#
# 脚本只从环境变量读取这些值，不读取本文件。密钥不要写进任何会提交的文件。

# ---- 模型（写稿、锐评、读图、导览文案） ----
# OpenAI 兼容端点的根地址，脚本在后面拼 /chat/completions。
DAILY_LLM_BASE_URL=https://llm.example.com/v1
# 端点上的模型名，默认 gemini-4-argon；端点用别的名字时设置。
DAILY_LLM_MODEL=gemini-4-argon
DAILY_LLM_API_KEY=

# ---- 微信数据（pipeline/） ----
# wx CLI 可执行文件。不设置时用 PATH 上的 wx。
WX_BIN=wx
# wx CLI 使用的 HOME 目录，它下面的 .wx-cli/ 存放这个账号的配置和解密缓存。
# 与 skill 里的 $WX_HOME 是同一个值。
WX_ACTIVITY_HOME=/path/to/wx-account-home

# newspaper 仓库的路径。两个仓库克隆在同一个父目录时不必设置，
# 本仓库的脚本默认使用本仓库旁边的 ../newspaper。相对路径按运行命令时的当前目录解析。
# NEWSPAPER_DIR=/path/to/newspaper

# ---- 发布（只有发布者需要） ----
# 赞踩 Worker 的 HTTPS 地址，公开构建时写入页面。
FEEDBACK_API_URL=https://feedback.example.workers.dev
# Cloudflare 账号 ID，计算语义检索向量时使用。
CLOUDFLARE_ACCOUNT_ID=
# 可选。不设置时脚本使用本机 wrangler 登录取得的令牌。
# CLOUDFLARE_API_TOKEN=
# 已核验可用的 wrangler 可执行文件。
WRANGLER_BIN=wrangler

# ---- skill 和手动命令使用的路径 ----
NEWSPAPER=/path/to/newspaper
BOT=/path/to/bot-workflow
PIPELINE="$BOT/pipeline"
WX_HOME=/path/to/wx-account-home
REPORTS=/path/to/reports
